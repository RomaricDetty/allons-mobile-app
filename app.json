{
    "expo": {
        "name": "AllOn",
        "slug": "allon-app-mobile",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/images/icon.png",
        "scheme": "allonappmobile",
        "userInterfaceStyle": "automatic",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/images/splash-icon-custom.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "assetBundlePatterns": [
            "**/*"
        ],
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.allon.app",
            "associatedDomains": [
                "applinks:customer.allon-apps.com"
            ],
            "infoPlist": {
                "UIViewControllerBasedStatusBarAppearance": false,
                "UILaunchStoryboardName": "SplashScreen",
                "UIApplicationSceneManifest": {
                    "UIApplicationSupportsMultipleScenes": false,
                    "UISceneConfigurations": {
                        "UIWindowSceneSessionRoleApplication": [
                            {
                                "UISceneConfigurationName": "Default Configuration",
                                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
                            }
                        ]
                    }
                },
                "NSLocationWhenInUseUsageDescription": "AllOn a besoin d'accéder à votre localisation pour vous montrer les arrêts de bus à proximité.",
                "NSLocationAlwaysAndWhenInUseUsageDescription": "AllOn a besoin d'accéder à votre localisation en arrière-plan pour le suivi en temps réel de votre trajet.",
                "NSLocationAlwaysUsageDescription": "AllOn a besoin d'accéder à votre localisation en arrière-plan pour le suivi de votre trajet.",
                "CFBundleURLTypes": [
                    {
                        "CFBundleURLSchemes": [
                            "allonappmobile",
                            "allon"
                        ]
                    }
                ]
            }
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#1776BA",
                "foregroundImage": "./assets/images/icon.png",
                "backgroundImage": "./assets/images/android-icon-background.png",
                "monochromeImage": "./assets/images/android-icon-monochrome.png"
            },
            "splash": {
                "image": "./assets/images/splash-icon-custom.png",
                "resizeMode": "contain",
                "backgroundColor": "#ffffff"
            },
            "edgeToEdgeEnabled": true,
            "predictiveBackGestureEnabled": false,
            "package": "com.allon.app",
            "permissions": [
                "ACCESS_COARSE_LOCATION",
                "ACCESS_FINE_LOCATION",
                "ACCESS_BACKGROUND_LOCATION"
            ],
            "intentFilters": [
                {
                    "action": "VIEW",
                    "autoVerify": true,
                    "data": [
                        {
                            "scheme": "https",
                            "host": "customer.allon-apps.com",
                            "pathPrefix": "/payment"
                        }
                    ],
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ]
                },
                {
                    "action": "VIEW",
                    "data": [
                        {
                            "scheme": "allon",
                            "host": "payment",
                            "pathPrefix": "/"
                        },
                        {
                            "scheme": "allonappmobile",
                            "host": "payment",
                            "pathPrefix": "/"
                        }
                    ],
                    "category": [
                        "BROWSABLE",
                        "DEFAULT"
                    ]
                }
            ]
        },
        "web": {
            "output": "static",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            "expo-secure-store",
            [
                "expo-notifications",
                {
                    "icon": "./assets/images/icon.png",
                    "color": "#1776BA",
                    "defaultChannel": "payment-status"
                }
            ],
            [
                "expo-location",
                {
                    "locationAlwaysAndWhenInUsePermission": "Permettre à $(PRODUCT_NAME) d'accéder à votre localisation pour le suivi en temps réel de votre trajet.",
                    "locationAlwaysPermission": "Permettre à $(PRODUCT_NAME) d'accéder à votre localisation en arrière-plan pour le suivi de votre trajet.",
                    "locationWhenInUsePermission": "Permettre à $(PRODUCT_NAME) d'accéder à votre localisation pour afficher votre position sur la carte."
                }
            ],
            [
                "@rnmapbox/maps",
                {
                    "RNMAPBOX_MAPS_DOWNLOAD_TOKEN": "",
                    "RNMapboxMapsVersion": "11.18.2"
                }
            ]
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        }
    }
}