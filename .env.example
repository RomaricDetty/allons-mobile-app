# Token Mapbox PUBLIC (pk.*) — utilisé au runtime par l’app. Safe à exposer côté client.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...

# Token Mapbox SECRET (sk.*) — UNIQUEMENT pour télécharger le SDK natif en build (EAS / local prebuild).
# Ne jamais committer. Définir aussi dans EAS Secrets.
MAPBOX_DOWNLOAD_TOKEN=sk.eyJ...
